              threadId: thread.id,
              turnId,
              createdAt: now,
              commandTag: "reasoning-complete",
              finalDeltaCommandTag: "reasoning-delta-finalize",
              hasProjectedMessage: existingReasoningMessage !== undefined,
              role: "reasoning",
              ...(fallbackText !== undefined ? { fallbackText } : {}),
